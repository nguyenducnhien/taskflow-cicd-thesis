# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=5000

# Must match database/schema.sql (CREATE DATABASE task_manager_db) and, later,
# the Docker Compose MySQL service's MYSQL_DATABASE.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=task_manager_db

# Use a long, random string in real .env — this is only a placeholder.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Origin of the ReactJS frontend, for CORS. No trailing slash.
CORS_ORIGIN=http://localhost:3000
